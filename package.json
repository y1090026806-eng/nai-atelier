{
  "name": "nai-atelier",
  "version": "2.0.0",
  "private": true,
  "description": "Local-first LLM tag generator + NovelAI image workbench",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "verify": "node scripts/verify.js",
    "test:sync": "node scripts/sync-selftest.js && node scripts/sync-e2e.js",
    "test": "npm run verify && npm run test:sync && npm run test:nai && npm run test:msgpack",
    "test:nai": "node scripts/test-nai.js",
    "test:msgpack": "node scripts/test-msgpack.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}
